#!/bin/bash

set -e

LOG_FILE="${TRIM_PKGVAR}/info.log"

log_msg() {
    local msg="$(date '+%Y-%m-%d %H:%M:%S') - [upgrade] $1"
    echo "$msg"
    echo "$msg" >> "${LOG_FILE}" 2>/dev/null || true
}

toast_err() {
    echo "$*" > "$TRIM_TEMP_LOGFILE"
}

# 全局错误捕获
trap 'toast_err "脚本出错(L${LINENO}): $(tail -3 "${LOG_FILE}" 2>/dev/null)"' ERR

DATA_DIR="${TRIM_PKGHOME}/data"
VAR_DIR="${TRIM_PKGVAR}"
VENV_DIR="${DATA_DIR}/venv"
HERMES="${VENV_DIR}/bin/hermes"
APP_DIR="${TRIM_APPDEST}"
UV_BIN="${DATA_DIR}/bin"

# Hermes Agent v0.20.0 起官方停止 PyPI wheel 分发（setup.py 构建守卫），
# 本包内置完整源码目录，升级时走 editable 安装（build_editable 不触发守卫）。
HERMES_SRC="${APP_DIR}/hermes-src"
. "${APP_DIR}/config/bootstrap/install-hermes.sh"

export HOME="${DATA_DIR}"

# uv 缓存目录放到 DATA_DIR 下，确保和 venv 同一文件系统，hardlink 可用
export UV_CACHE_DIR="${DATA_DIR}/.uv-cache"

export PIP_INDEX_URL="https://mirrors.aliyun.com/pypi/simple/"
export UV_INDEX_URL="https://mirrors.aliyun.com/pypi/simple/"

# ---------------------------------------------------------------------------
# curl 从阿里云 PyPI 镜像直接下载 uv wheel，unzip 提取二进制
# ---------------------------------------------------------------------------
ensure_uv() {
    if [ -x "${UV_BIN}/uv" ]; then
        UV="${UV_BIN}/uv"
        log_msg "uv found (persistent): ${UV}"
    else
        log_msg "uv not found, installing via curl ..."
        mkdir -p "${UV_BIN}"
        mkdir -p "$(dirname "${LOG_FILE}")" 2>/dev/null || true
        local TMP_DIR
        TMP_DIR="$(mktemp -d)"

        local ARCH
        case "$(uname -m)" in
            x86_64)  ARCH="x86_64" ;;
            aarch64) ARCH="aarch64" ;;
            *)       ARCH="$(uname -m)" ;;
        esac

        log_msg ">>> 正在从 PyPI 镜像下载 uv (${ARCH}) ..."

        # 多源查询 uv wheel：阿里云 → 清华 → 官方 PyPI（任一源查到即用；URL 必须 /simple/uv/）
        local WHEEL_URL=""
        for IDX in \
            "https://mirrors.aliyun.com/pypi/simple/uv/" \
            "https://pypi.tuna.tsinghua.edu.cn/simple/uv/" \
            "https://pypi.org/simple/uv/"
        do
            log_msg "querying uv wheel index: ${IDX}"
            WHEEL_URL=$(curl -LsSf --connect-timeout 15 --max-time 30 "${IDX}" 2>>"${LOG_FILE}" \
                | grep -o 'href="[^"]*py3-none-manylinux[^"]*' \
                | grep "${ARCH}" \
                | sed 's|^href="../../|https://mirrors.aliyun.com/pypi/|; s|^href="||; s|#sha256=.*||' \
                | sort -t'-' -k2,2V \
                | tail -1)
            if [ -n "${WHEEL_URL}" ]; then
                log_msg "uv wheel URL: ${WHEEL_URL}"
                break
            fi
        done

        local UV_WHL="${TMP_DIR}/uv.whl"
        if [ -n "${WHEEL_URL}" ]; then
            if curl -L --retry 3 --retry-delay 3 --connect-timeout 15 --progress-bar -o "${UV_WHL}" "${WHEEL_URL}" 2>&1 \
               && unzip -o -j "${UV_WHL}" "uv-*.data/scripts/uv" -d "${UV_BIN}" >>"${LOG_FILE}" 2>&1; then
                log_msg "uv extracted from wheel"
            fi
        else
            log_msg "simple index query failed, trying GitHub fallback ..."
        fi

        # wheel 下载失败 → GitHub tar.gz 兜底（ghproxy 中继优先，直连兜底）
        if [ ! -x "${UV_BIN}/uv" ]; then
            log_msg ">>> wheel 方式失败，尝试 GitHub 下载 ..."
            local UV_TAR="uv-${ARCH}-unknown-linux-gnu"
            local UV_GZ="${TMP_DIR}/uv.tar.gz"
            local UV_GZ_OK=false
            if curl -L --retry 3 --retry-delay 5 --connect-timeout 15 --progress-bar \
                 -o "${UV_GZ}" "https://ghproxy.net/https://github.com/astral-sh/uv/releases/latest/download/${UV_TAR}.tar.gz" 2>&1 \
               && tar tzf "${UV_GZ}" >/dev/null 2>&1 \
               && tar xzf "${UV_GZ}" -C "${UV_BIN}" --strip-components=1 "${UV_TAR}/uv" 2>&1; then
                UV_GZ_OK=true
                log_msg "uv extracted from GitHub tarball (ghproxy)"
            fi
            if [ "${UV_GZ_OK}" != "true" ] && curl -L --retry 3 --retry-delay 5 --connect-timeout 15 --progress-bar \
                 -o "${UV_GZ}" "https://github.com/astral-sh/uv/releases/latest/download/${UV_TAR}.tar.gz" 2>&1 \
               && tar tzf "${UV_GZ}" >/dev/null 2>&1 \
               && tar xzf "${UV_GZ}" -C "${UV_BIN}" --strip-components=1 "${UV_TAR}/uv" 2>&1; then
                log_msg "uv extracted from GitHub tarball"
            fi
        fi

        rm -rf "${TMP_DIR}"

        if [ -x "${UV_BIN}/uv" ]; then
            UV="${UV_BIN}/uv"
            log_msg "uv installed: ${UV}"
        else
            toast_err "uv 安装失败: $(tail -3 "${LOG_FILE}" 2>/dev/null)"
            exit 1
        fi
    fi

    log_msg "uv version: $("${UV}" --version 2>&1 || echo 'FAILED')"
}

# ---------------------------------------------------------------------------
# 1. 读取目标版本号（从 hermes-version.env，manifest 不部署到设备）
# ---------------------------------------------------------------------------
if [ ! -f "${APP_DIR}/config/bootstrap/hermes-version.env" ]; then
    toast_err "hermes-version.env 不存在，请检查打包是否包含 config/bootstrap/"
    exit 1
fi
# shellcheck disable=SC1090
. "${APP_DIR}/config/bootstrap/hermes-version.env"
if [ -z "${HERMES_VERSION}" ]; then
    toast_err "hermes-version.env 中未定义 HERMES_VERSION"
    exit 1
fi
log_msg "hermes-agent target version: ${HERMES_VERSION}"

# ---------------------------------------------------------------------------
# 2. 用 uv pip show 快速检测当前版本
# ---------------------------------------------------------------------------
ensure_uv

# 把 uv 软链接进 venv/bin，让 hermes 运行时（PATH 仅含 venv/bin）能找到 uv
# 放在版本检测之前，确保即使版本匹配提前退出也会执行
if [ -x "${UV_BIN}/uv" ] && [ -d "${VENV_DIR}/bin" ]; then
    ln -sf "${UV_BIN}/uv" "${VENV_DIR}/bin/uv"
    if [ -x "${VENV_DIR}/bin/uv" ]; then
        log_msg "uv symlinked into venv/bin"
    else
        log_msg "WARNING: uv symlink into venv/bin failed"
    fi
fi

INSTALLED_VER=""
# v0.22.x 起 pip show 读不到真实版本（pyproject version=0.0.0）：
# 优先读 install-stamp.json 的 displayVersion，回退 hermes --version 正则，
# 同时确认 venv python 是 3.14（否则依赖门控装不出核心功能，强制重装）。
if [ -f "${HERMES_SRC}/install-stamp.json" ]; then
    INSTALLED_VER=$("${VENV_DIR}/bin/python3" -c 'import json,sys;print(json.load(open(sys.argv[1])).get("displayVersion",""))' "${HERMES_SRC}/install-stamp.json" 2>/dev/null || echo "")
fi
if [ -z "${INSTALLED_VER}" ] && [ -x "${HERMES}" ]; then
    INSTALLED_VER=$("${HERMES}" --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1 || echo "")
fi
VENV_PYVER=$("${VENV_DIR}/bin/python3" -c 'import sys;print("%d.%d"%sys.version_info[:2])' 2>/dev/null || echo none)

if [ -n "${INSTALLED_VER}" ] && [ "${INSTALLED_VER}" = "${HERMES_VERSION}" ] && [ "${VENV_PYVER}" = "3.14" ] && hermes_dependencies_current; then
    # 版本匹配且 python 3.14，再验证二进制能跑
    if [ -x "${HERMES}" ] && timeout 10 "${HERMES}" --version >/dev/null 2>&1; then
        log_msg "hermes OK: ${INSTALLED_VER} (venv python ${VENV_PYVER}, matches target)"
        trap - ERR
        log_msg "upgrade_callback finished (no action needed)."
        exit 0
    fi
    log_msg "version matches but binary broken, will reinstall"
elif [ -n "${INSTALLED_VER}" ] && [ "${VENV_PYVER}" != "3.14" ]; then
    # python 非 3.14：依赖门控失效，必须重建 3.14 venv 后重装
    log_msg "venv python ${VENV_PYVER:-none} != 3.14, will rebuild venv + reinstall"
elif [ -n "${INSTALLED_VER}" ] && [ "${INSTALLED_VER}" != "${HERMES_VERSION}" ] && [ "$(printf '%s\n%s' "${INSTALLED_VER}" "${HERMES_VERSION}" | sort -V | tail -1)" = "${INSTALLED_VER}" ]; then
    # 本地版本 > 目标版本，不降级
    log_msg "installed ${INSTALLED_VER} > target ${HERMES_VERSION}, skipping (no downgrade)"
    trap - ERR
    log_msg "upgrade_callback finished (no action needed)."
    exit 0
elif [ -n "${INSTALLED_VER}" ]; then
    log_msg "version mismatch: installed=${INSTALLED_VER}, target=${HERMES_VERSION}"
else
    log_msg "hermes-agent not found in venv (venv python ${VENV_PYVER:-none})"
fi

# ---------------------------------------------------------------------------
# 3. 安装/升级 hermes-agent（uv pip install 覆盖装，不删 venv）
# ---------------------------------------------------------------------------

# 如果 venv 不存在、损坏，或 python 非 3.14，先重建
# v0.22.1 起官方 48 个核心依赖门控到 `python_version >= "3.14"`：
# 老用户 venv（3.11）若保留会装出空依赖 → hermes 启动但 dashboard/voice 缺失。
# 因此凡 python 主版本非 3.14 一律重建为 3.14（内置预置包零下载优先，方案 2）。
VENV_PYVER=$("${VENV_DIR}/bin/python3" -c 'import sys;print("%d.%d"%sys.version_info[:2])' 2>/dev/null || echo none)
if ! hermes_cpython_ok; then
    if [ -d "${VENV_DIR}" ]; then
        log_msg ">>> 旧 venv (python ${VENV_PYVER:-none}) 非 3.14，正在重建 ..."
        rm -rf "${VENV_DIR}" 2>/dev/null || true
    else
        log_msg ">>> 正在创建 Python 3.14 虚拟环境 ..."
    fi
    if ! ensure_hermes_venv; then
        toast_err "venv 创建 / CPython 3.14 安装失败: $(tail -5 "${LOG_FILE}" 2>/dev/null)"
        exit 1
    fi
fi

# 安装/覆盖安装 hermes-agent：优先内置源码 editable 安装，无源码时退回 PyPI wheel
# v0.22.1：extras 用 [all,voice]（voice 带 faster-whisper STT 依赖，新装/升级即就绪）
if ! install_hermes_from_source; then
    toast_err "hermes-agent 安装失败（三源均失败）: $(tail -5 "${LOG_FILE}" 2>/dev/null)"
    exit 1
fi

log_msg "hermes binary verified"

# 版本报告：v0.22.x 起 pip show 读不到（version=0.0.0），优先读 install-stamp
ACTUAL_VER=$("${VENV_DIR}/bin/python3" -c 'import json,sys;print(json.load(open(sys.argv[1])).get("displayVersion",""))' "${HERMES_SRC}/install-stamp.json" 2>/dev/null || echo "")
if [ -z "${ACTUAL_VER}" ]; then
    ACTUAL_VER=$("${HERMES}" --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1 || echo "unknown")
fi
log_msg "hermes upgraded: ${ACTUAL_VER} (venv python ${VENV_PYVER:-unknown})"

# 清除版本缓存，让 monitor.js 下次启动时重新检测真实版本
rm -f "${VAR_DIR}/hermes_version.txt" 2>/dev/null || true
log_msg "version cache cleared"

# ---------------------------------------------------------------------------
# 4. 部署 prompts
# ---------------------------------------------------------------------------
PROMPTS_SRC="${APP_DIR}/config/prompts"
if [ -d "${PROMPTS_SRC}" ]; then
    # skills/ — 始终覆盖（跟随版本）
    if [ -d "${PROMPTS_SRC}/skills" ]; then
        mkdir -p "${DATA_DIR}/skills"
        cp -a "${PROMPTS_SRC}/skills/." "${DATA_DIR}/skills/"
        log_msg "skills redeployed"
    fi

    # 清理旧版本遗留的已合并技能目录（v5→v3 精简）
    for OLD_SKILL in fnos-common-workflows fnos-dev fnos-ops fnos-ws-api; do
        OLD_DIR="${DATA_DIR}/skills/fnos-knowledge/${OLD_SKILL}"
        if [ -d "${OLD_DIR}" ]; then
            rm -rf "${OLD_DIR}"
            log_msg "removed legacy skill: ${OLD_SKILL}"
        fi
    done

    # SOUL.md — 不存在才复制
    if [ -f "${PROMPTS_SRC}/SOUL.md" ] && [ ! -f "${DATA_DIR}/SOUL.md" ]; then
        cp "${PROMPTS_SRC}/SOUL.md" "${DATA_DIR}/SOUL.md"
        log_msg "SOUL.md deployed (missing)"
    fi

    # AGENTS.md — 不存在才复制
    if [ -f "${PROMPTS_SRC}/AGENTS.md" ] && [ ! -f "${DATA_DIR}/AGENTS.md" ]; then
        cp "${PROMPTS_SRC}/AGENTS.md" "${DATA_DIR}/AGENTS.md"
        log_msg "AGENTS.md deployed (missing)"
    fi

    # config.yaml — 不存在才复制
    if [ -f "${PROMPTS_SRC}/config.yaml" ] && [ ! -f "${DATA_DIR}/config.yaml" ]; then
        cp "${PROMPTS_SRC}/config.yaml" "${DATA_DIR}/config.yaml"
        log_msg "config.yaml deployed (missing)"
    fi

    # config.yaml 版本戳 — 幂等补 _config_version：无此字段时 hermes 核心 post_update
    # 把"无版本戳"当 ver 0，误判低于 support floor(v12) 而跳过迁移并报 WARNING
    # （"config migration skipped: predates version 12" 即此因）。
    # 新装模板已带最新戳；存量升级时 config.yaml 已存在不会重拷，此处动态取核心声明值补戳兜底。
    if [ -f "${DATA_DIR}/config.yaml" ] && ! grep -qE '^_config_version:' "${DATA_DIR}/config.yaml"; then
        _LATEST=$(grep -oE '"_config_version": *[0-9]+' "${HERMES_SRC}/hermes_cli/config_defaults.py" 2>/dev/null | grep -oE '[0-9]+' | head -1)
        if [ -n "${_LATEST}" ]; then
            # 追加前保证文件以换行结尾（末尾无换行时 echo >> 会把戳粘到最后一行上，破坏 YAML）
            [ -n "$(tail -c 1 "${DATA_DIR}/config.yaml")" ] && printf '\n' >> "${DATA_DIR}/config.yaml"
            echo "_config_version: ${_LATEST}" >> "${DATA_DIR}/config.yaml"
            log_msg "config.yaml 已幂等补 _config_version: ${_LATEST}（防核心跳过迁移）"
        else
            log_msg "WARNING: 未能从 config_defaults.py 解析 _config_version，跳过补戳"
        fi
    fi

    # 工作台（work-ui）中文默认 — 幂等补写：运行时 config 的 display.language
    # 从 en 替换为 zh（已是 zh/其他值时不匹配即跳过，不影响用户手动改过的配置）。
    if [ -f "${DATA_DIR}/config.yaml" ] && grep -q "^  language: en$" "${DATA_DIR}/config.yaml"; then
        _lc_tmp="${DATA_DIR}/config.yaml.tmp"
        if sed 's/^  language: en$/  language: zh/' "${DATA_DIR}/config.yaml" > "${_lc_tmp}"; then
            mv "${_lc_tmp}" "${DATA_DIR}/config.yaml"
            log_msg "display.language preseeded to zh (work-ui Chinese, idempotent)"
        else
            rm -f "${_lc_tmp}"
            log_msg "WARNING: display.language preseed failed, work-ui falls back to English"
        fi
    fi

    # 工作区磁盘扫描默认根 — 存量用户升级时幂等补写（老模板没有 desktop 段）
    # 指向 TRIM_PKGHOME/workspaces（HERMES_HOME 之外；core junk 策略会过滤 HERMES_HOME 内的仓库）
    # 守卫：已有 desktop: 段时不追加（避免 YAML 重复键）
    if [ -n "${TRIM_PKGHOME}" ]; then
        mkdir -p "${TRIM_PKGHOME}/workspaces"
        if [ -f "${DATA_DIR}/config.yaml" ] \
           && ! grep -q "repo_scan_roots" "${DATA_DIR}/config.yaml" 2>/dev/null \
           && ! grep -qE '^desktop:' "${DATA_DIR}/config.yaml" 2>/dev/null; then
            cat >> "${DATA_DIR}/config.yaml" <<EOF

desktop:
  repo_scan_roots:
  - ${TRIM_PKGHOME}/workspaces
EOF
            log_msg "desktop.repo_scan_roots backfilled on upgrade"
        fi
    fi
fi

# ---------------------------------------------------------------------------
# 5. 修复权限
# ---------------------------------------------------------------------------
if [ -n "${TRIM_USERNAME}" ]; then
    log_msg "=== 修复权限 ==="
    log_msg "TRIM_USERNAME=${TRIM_USERNAME}"
    log_msg "APP_DIR=${APP_DIR} owner=$(stat -c '%U:%G' "${APP_DIR}" 2>/dev/null || echo 'N/A') perms=$(stat -c '%a' "${APP_DIR}" 2>/dev/null || echo 'N/A')"
    log_msg "DATA_DIR=${DATA_DIR} owner=$(stat -c '%U:%G' "${DATA_DIR}" 2>/dev/null || echo 'N/A') perms=$(stat -c '%a' "${DATA_DIR}" 2>/dev/null || echo 'N/A')"

    if chown -R "${TRIM_USERNAME}:${TRIM_USERNAME}" "${APP_DIR}" 2>>"${LOG_FILE}"; then
        log_msg "chown -R ${TRIM_USERNAME}:${TRIM_USERNAME} ${APP_DIR} → OK"
    else
        log_msg "chown -R ${TRIM_USERNAME}:${TRIM_USERNAME} ${APP_DIR} → FAILED (exit=$?)"
    fi
    if chmod 775 "${APP_DIR}" 2>>"${LOG_FILE}"; then
        log_msg "chmod 775 ${APP_DIR} → OK"
    else
        log_msg "chmod 775 ${APP_DIR} → FAILED (exit=$?)"
    fi
    if chown -R "${TRIM_USERNAME}:${TRIM_USERNAME}" "${DATA_DIR}" 2>>"${LOG_FILE}"; then
        log_msg "chown -R ${TRIM_USERNAME}:${TRIM_USERNAME} ${DATA_DIR} → OK"
    else
        log_msg "chown -R ${TRIM_USERNAME}:${TRIM_USERNAME} ${DATA_DIR} → FAILED (exit=$?)"
    fi
    if chmod -R 750 "${DATA_DIR}" 2>>"${LOG_FILE}"; then
        log_msg "chmod -R 750 ${DATA_DIR} → OK"
    else
        log_msg "chmod -R 750 ${DATA_DIR} → FAILED (exit=$?)"
    fi

    log_msg "--- 权限修复后目录状态 ---"
    ls -la "${APP_DIR}" 2>&1 | while IFS= read -r line; do log_msg "  $line"; done
else
    log_msg "TRIM_USERNAME 为空，跳过权限修复"
fi



# —— 知识整合初始化（升级补缺：copy_if_new 不覆盖已有内容） ——
if [ -x "${TRIM_APPDEST:-/var/apps/hermes-agent}/init/init.sh" ]; then
    log_msg '>>> 运行知识整合初始化 (init.sh) ...'
    "${TRIM_APPDEST:-/var/apps/hermes-agent}/init/init.sh" >> "${TRIM_PKGVAR}/info.log" 2>&1 || log_msg 'WARNING: init.sh 执行失败'
fi

trap - ERR
log_msg "upgrade_callback finished successfully."
exit 0
