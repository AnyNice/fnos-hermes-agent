@@ -156,6 +156,32 @@
     return entry
 
 
+_GW_CFG_TTL = 2.0
+_gw_cfg_memo: tuple[float, Any] | None = None
+
+
+def _shared_gateway_config() -> Any:
+    """Share one gateway-config load across the unscoped enablement checks.
+
+    ``load_gateway_config()`` re-reads + re-parses the whole gateway config on every
+    call (~0.3s warm). ``_platform_enablement`` invoked it once per platform per
+    request, so ``GET /api/messaging/platforms`` cost ~32 × 0.3s ≈ 10s on every page
+    load. One load, shared for a short window: the config only changes when a user
+    saves platform settings, and the UI re-polls this endpoint on page loads, which
+    are spaced well over the TTL.
+    """
+    global _gw_cfg_memo
+    now = time.monotonic()
+    memo = _gw_cfg_memo
+    if memo is not None and now - memo[0] < _GW_CFG_TTL:
+        return memo[1]
+    from gateway.config import load_gateway_config
+
+    cfg = load_gateway_config()
+    _gw_cfg_memo = (now, cfg)
+    return cfg
+
+
 def _platform_enablement(
     platform_id: str, entry: dict[str, Any], env_on_disk: dict[str, str], scoped: bool
 ) -> tuple[bool, bool, dict | None]:
